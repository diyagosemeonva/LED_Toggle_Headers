#include "stm32f4xx.h"


#define GPIOAEN                    (1U<<0)

#define PIN5                       (1U<<5)
#define LED_PIN                    PIN5

int main(void)
{
	RCC->AHB1ENR |= GPIOAEN;
	GPIOA->MODER |= (1U<<10);
	GPIOA->MODER  &=~(1U<<11);

	while(1)
	{
		for (int i=0;i<10;i++)
		{
			GPIOA->OD_R   ^=  LED_PIN;
			for(int d=0;d<100000;d++)
			{}
		}
		for (int i=0;i<4;i++)
		{
			GPIOA->OD_R   ^=  LED_PIN;
			for(int d=0;d<500000;d++)
			{}
		}
	}
}
