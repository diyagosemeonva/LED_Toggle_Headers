#include "stm32f4xx.h"


#define GPIOAEN                    (1U<<0)

#define PIN5                       (1U<<5)
#define LED_PIN                    PIN5

int main(void)
{
	RCC_AHB1EN_R |= GPIOAEN;
	GPIOA_MODE_R |= (1U<<10);
	GPIOA_MODE_R  &=~(1U<<11);

	while(1)
	{
		for (int i=0;i<10;i++)
		{
			GPIOA_OD_R   ^=  LED_PIN ;
			for(int d=0;d<100000;d++)
			{}
		}
		for (int i=0;i<4;i++)
		{
			GPIOA_OD_R   ^=  LED_PIN ;
			for(int d=0;d<500000;d++)
			{}
		}
	}
}
